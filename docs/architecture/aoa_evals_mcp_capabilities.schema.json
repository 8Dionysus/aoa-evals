{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abyss.local/schemas/aoa-evals/mcp-capabilities-v1.json",
  "title": "aoa-evals MCP organ capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "organ_id",
    "source_owner",
    "access_runtime_owner",
    "admission_owner",
    "proof_owner",
    "contains_secrets",
    "admission_asserted",
    "owner_acceptance_asserted",
    "proof_issuance_via_mcp_allowed",
    "effect_activation_authorized",
    "capabilities",
    "guardrails"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "aoa_evals_mcp_capabilities_v1"},
    "organ_id": {"const": "aoa-evals"},
    "source_owner": {"const": "aoa-evals"},
    "access_runtime_owner": {"const": "abyss-stack"},
    "admission_owner": {"const": "aoa-sdk"},
    "proof_owner": {"const": "aoa-evals"},
    "contains_secrets": {"const": false},
    "admission_asserted": {"const": false},
    "owner_acceptance_asserted": {"const": false},
    "proof_issuance_via_mcp_allowed": {"const": false},
    "effect_activation_authorized": {"const": false},
    "capabilities": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/capability"}
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eval_execution_allowed",
        "verdict_computation_allowed",
        "report_publication_allowed",
        "proof_acceptance_inference_allowed",
        "registry_mutation_allowed",
        "hidden_mcp_chaining_allowed",
        "annotations_are_security_enforcement",
        "discovery_can_expand_write_roots"
      ],
      "properties": {
        "eval_execution_allowed": {"const": false},
        "verdict_computation_allowed": {"const": false},
        "report_publication_allowed": {"const": false},
        "proof_acceptance_inference_allowed": {"const": false},
        "registry_mutation_allowed": {"const": false},
        "hidden_mcp_chaining_allowed": {"const": false},
        "annotations_are_security_enforcement": {"const": false},
        "discovery_can_expand_write_roots": {"const": false}
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "policy_family",
        "credential_class",
        "process_contour",
        "authority_ceiling",
        "primitives"
      ],
      "properties": {
        "capability_id": {"type": "string", "minLength": 1},
        "policy_family": {"enum": ["read", "candidate"]},
        "credential_class": {"enum": ["evals-read", "evals-candidate"]},
        "process_contour": {"enum": ["read", "candidate"]},
        "authority_ceiling": {"type": "string", "minLength": 1},
        "primitives": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/primitive"}
        }
      }
    },
    "primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primitive_id",
        "kind",
        "mcp_name",
        "effect_class",
        "idempotency",
        "approval_required",
        "maximum_blast_radius",
        "rollback_route"
      ],
      "properties": {
        "primitive_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["tool", "resource", "resource_template"]},
        "mcp_name": {"type": "string", "minLength": 1},
        "effect_class": {"enum": ["observe", "derive", "prepare_candidate"]},
        "idempotency": {"enum": ["read_only", "idempotent"]},
        "approval_required": {"type": "boolean"},
        "maximum_blast_radius": {"type": "string", "minLength": 1},
        "rollback_route": {"type": ["string", "null"]}
      }
    }
  }
}
