{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aoa-evals:adjacent-provider-envelope-evidence:v1",
  "type": "object",
  "required": ["schema", "goal_id", "observed_at", "source_epoch", "artifact", "providers", "raw_evidence", "batches", "summary", "claim_limits"],
  "properties": {
    "schema": {"const": "abyssos_adjacent_provider_evidence_v1"},
    "goal_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "source_epoch": {"type": "string", "pattern": "^(commit|git|sha256):"},
    "artifact": {
      "type": "object",
      "required": ["sha256", "subject_digest", "signature_status", "admission_status"],
      "properties": {
        "sha256": {"$ref": "#/$defs/digest"},
        "subject_digest": {"$ref": "#/$defs/digest"},
        "signature_status": {"const": "missing"},
        "admission_status": {"const": "not_admitted"}
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semgrep", "syft", "in-toto", "markitdown"],
      "properties": {
        "semgrep": {"$ref": "#/$defs/provider_metadata"},
        "syft": {"$ref": "#/$defs/provider_metadata"},
        "in-toto": {"$ref": "#/$defs/provider_metadata"},
        "markitdown": {"$ref": "#/$defs/provider_metadata"}
      }
    },
    "raw_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sarif", "sbom", "in_toto", "document_markdown"],
      "properties": {
        "sarif": {"$ref": "#/$defs/raw_evidence_ref"},
        "sbom": {"$ref": "#/$defs/raw_evidence_ref"},
        "in_toto": {"$ref": "#/$defs/raw_evidence_ref"},
        "document_markdown": {"$ref": "#/$defs/raw_evidence_ref"}
      }
    },
    "batches": {
      "type": "object",
      "required": ["static_security", "software_components", "artifact_provenance", "document_structure"],
      "additionalProperties": false,
      "properties": {
        "static_security": {"$ref": "#/$defs/batch"},
        "software_components": {"$ref": "#/$defs/batch"},
        "artifact_provenance": {"$ref": "#/$defs/batch"},
        "document_structure": {"$ref": "#/$defs/batch"}
      }
    },
    "summary": {"type": "object"},
    "claim_limits": {
      "const": [
        "Actual provider execution and common-envelope normalization are shown.",
        "Candidate execution does not establish artifact admission or deployed runtime availability.",
        "The packet does not establish scanner completeness, SBOM completeness, document fidelity, semantic proof, landing, or owner acceptance."
      ]
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provider_config_digest": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
    "provider_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "runtime_posture"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "runtime_posture": {"type": "string", "minLength": 1}
      }
    },
    "raw_evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "batch": {
      "type": "object",
      "required": ["schema_version", "capability_class", "provider", "source", "parse_status", "observations", "qualification", "currentness", "provenance"],
      "properties": {
        "schema_version": {"const": "aoa-code-observation-v1"},
        "capability_class": {"enum": ["static-security", "software-components", "artifact-provenance", "document-structure"]},
        "provider": {
          "type": "object",
          "required": ["id", "version", "config_digest", "lane"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "config_digest": {"$ref": "#/$defs/provider_config_digest"},
            "lane": {
              "type": "object",
              "required": ["id", "status"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "status": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "source": {"type": "object"},
        "parse_status": {"const": "parsed"},
        "observations": {"type": "array", "minItems": 1},
        "qualification": {"type": "object"},
        "currentness": {
          "type": "object",
          "required": ["provider"],
          "properties": {"provider": {"type": "object"}}
        },
        "provenance": {
          "type": "object",
          "required": ["extractor_ref", "parser_ref", "source_refs"],
          "properties": {
            "extractor_ref": {"type": "string", "minLength": 1},
            "parser_ref": {"type": "string", "minLength": 1},
            "source_refs": {"type": "array", "minItems": 1}
          }
        }
      }
    }
  }
}
