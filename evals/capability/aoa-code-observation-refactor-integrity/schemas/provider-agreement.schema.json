{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aoa-evals:code-observation-provider-agreement:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observed_at", "required_facts", "envelopes", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "aoa_code_observation_provider_agreement_v1"},
    "observed_at": {"type": "string", "format": "date-time"},
    "required_facts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(definition|references|calls):[^:]+$"}
    },
    "claim_boundary": {
      "const": "This exact-source-epoch comparison checks only agreement among supplied, unadmitted normalized observations; it is not provider correctness, machine admission, runtime health, KAG acceptance, proof promotion, or owner acceptance."
    },
    "envelopes": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/envelope"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
    "envelope": {
      "type": "object",
      "required": ["schema_version", "provider", "source", "parse_status", "observations", "qualification"],
      "properties": {
        "schema_version": {"const": "aoa-code-observation-v1"},
        "provider": {
          "type": "object",
          "required": ["id", "version", "config_digest", "lane"],
          "properties": {
            "id": {"enum": ["tree-sitter", "scip", "lsp"]},
            "version": {"type": "string", "minLength": 1},
            "config_digest": {"$ref": "#/$defs/digest"},
            "lane": {"type": "object"}
          }
        },
        "source": {
          "type": "object",
          "required": ["repo", "path", "source_epoch", "content_digest", "language"],
          "properties": {
            "repo": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "source_epoch": {"type": "string", "minLength": 1},
            "content_digest": {"$ref": "#/$defs/digest"},
            "language": {"const": "typescript"}
          }
        },
        "parse_status": {"enum": ["parsed", "degraded", "unparseable"]},
        "observations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "qualification": {"type": "object"}
      }
    }
  }
}
