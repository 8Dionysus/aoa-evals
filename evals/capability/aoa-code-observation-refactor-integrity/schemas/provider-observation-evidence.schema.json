{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aoa-evals:code-observation-provider-evidence:v1",
  "title": "AOA code observation provider evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "family_id",
    "fixture_manifest_digest",
    "source_manifest_digest",
    "observed_at",
    "providers",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "aoa_code_observation_provider_evidence_v1"},
    "family_id": {"const": "refactor-torture-v1"},
    "fixture_manifest_digest": {"$ref": "#/$defs/digest"},
    "source_manifest_digest": {"$ref": "#/$defs/digest"},
    "observed_at": {"type": "string", "format": "date-time"},
    "claim_boundary": {"type": "string", "minLength": 60},
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provider"}
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*://)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "source_path", "start_line", "end_line"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "source_path": {"$ref": "#/$defs/path"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "status", "source_paths", "symbols"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["observed", "not_available", "failed"]},
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        },
        "symbols": {
          "type": "array",
          "items": {"$ref": "#/$defs/symbol"}
        },
        "error": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "observed"}}},
          "then": {"required": ["symbols"]}
        },
        {
          "if": {"properties": {"status": {"const": "failed"}}},
          "then": {"required": ["error"]}
        }
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "version",
        "config_digest",
        "command_ref",
        "availability",
        "admission_state",
        "source_root",
        "case_ids",
        "observations",
        "claim_limits"
      ],
      "properties": {
        "id": {"enum": ["python-ast", "ctags-host"]},
        "kind": {"enum": ["python-ast", "ctags"]},
        "version": {"type": "string", "minLength": 1},
        "config_digest": {"$ref": "#/$defs/digest"},
        "command_ref": {"type": "string", "minLength": 1},
        "availability": {"enum": ["available", "not_available"]},
        "admission_state": {"const": "not_admitted"},
        "source_root": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "digest"],
          "properties": {
            "path": {"$ref": "#/$defs/path"},
            "digest": {"$ref": "#/$defs/digest"}
          }
        },
        "case_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "observations": {
          "type": "array",
          "items": {"$ref": "#/$defs/observation"}
        },
        "claim_limits": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"availability": {"const": "available"}}},
          "then": {
            "properties": {
              "case_ids": {"minItems": 1},
              "observations": {"minItems": 1}
            }
          }
        }
      ]
    }
  }
}
