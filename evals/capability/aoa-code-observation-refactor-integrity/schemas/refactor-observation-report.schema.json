{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aoa-evals:code-observation-refactor-report:v1",
  "title": "AOA code observation refactor report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "source_epoch", "run", "observations"],
  "properties": {
    "schema_version": {"const": "aoa_code_observation_refactor_report_v1"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "config_digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "config_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "source_epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "observed_at", "planes", "fixture_digest", "reproducibility"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "planes": {"$ref": "#/$defs/planes"},
        "fixture_digest": {"$ref": "#/$defs/digest"},
        "reproducibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "environment_digest", "command_ref"],
          "properties": {
            "state": {"enum": ["deterministic", "non-deterministic", "unknown"]},
            "environment_digest": {"$ref": "#/$defs/digest"},
            "command_ref": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "planes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["live", "indexed"]}
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "operation",
        "planes",
        "evidence_state",
        "semantic_identity",
        "lineage",
        "freshness",
        "invalidation",
        "metrics",
        "provenance",
        "affected_tests"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "planes": {"$ref": "#/$defs/planes"},
        "evidence_state": {"enum": ["complete", "stale", "ambiguous", "partial"]},
        "semantic_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entities"],
          "properties": {
            "entities": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["semantic_id", "kind", "occurrences", "relations"],
                "properties": {
                  "semantic_id": {"type": "string", "minLength": 1},
                  "kind": {"type": "string", "minLength": 1},
                  "occurrences": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["snapshot", "path", "start_line", "end_line"],
                      "properties": {
                        "snapshot": {"enum": ["before", "after"]},
                        "path": {"type": "string", "minLength": 1},
                        "start_line": {"type": "integer", "minimum": 1},
                        "end_line": {"type": "integer", "minimum": 1}
                      }
                    }
                  },
                  "relations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "target"],
                      "properties": {
                        "kind": {"type": "string", "minLength": 1},
                        "target": {"type": "string", "minLength": 1}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["posture", "confidence", "alternatives"],
          "properties": {
            "posture": {"enum": ["preserve", "branched", "not-applicable"]},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "alternatives": {"type": "integer", "minimum": 0}
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "observed_at", "source_epoch_ref", "provider_watermark"],
          "properties": {
            "status": {"enum": ["exact", "stale", "unknown"]},
            "observed_at": {"type": "string", "format": "date-time"},
            "source_epoch_ref": {"type": "string", "minLength": 1},
            "provider_watermark": {"type": "string", "minLength": 1}
          }
        },
        "invalidation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "affected_paths", "recomputed_paths", "reused_artifacts", "delta_full_parity"],
          "properties": {
            "scope": {"enum": ["file", "affected-subgraph", "full"]},
            "affected_paths": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "recomputed_paths": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "reused_artifacts": {
              "type": "integer",
              "minimum": 0,
              "description": "Count of controlled source artifacts left unrecomputed; the runner derives and validates this value from the fixture source universe and expected recomputed paths."
            },
            "delta_full_parity": {"enum": ["equal", "different", "not-run"]}
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric_id", "value", "unit", "status"],
            "properties": {
              "metric_id": {
                "enum": [
                  "definitions_references",
                  "dependency_relations",
                  "lineage_continuity",
                  "freshness",
                  "invalidation_blast_radius",
                  "provenance",
                  "affected_tests",
                  "ambiguity",
                  "source_epoch",
                  "delta_full_parity",
                  "reproducibility",
                  "latency",
                  "resource_cost"
                ]
              },
              "value": {"type": ["number", "null"]},
              "unit": {"type": "string", "minLength": 1},
              "status": {"enum": ["observed", "not-run", "unknown"]}
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_ref", "source_epoch_ref", "provider_ref", "config_ref"],
          "properties": {
            "source_ref": {"type": "string", "minLength": 1},
            "source_epoch_ref": {"type": "string", "minLength": 1},
            "provider_ref": {"type": "string", "minLength": 1},
            "config_ref": {"$ref": "#/$defs/digest"}
          }
        },
        "affected_tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "selected", "oracle_ref"],
          "properties": {
            "status": {"enum": ["selected", "empty", "unknown", "not-applicable"]},
            "selected": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "oracle_ref": {"type": ["string", "null"]}
          }
        }
      }
    }
  }
}
