{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "aoa-identity-bound-method-comparison comparative-summary report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eval_name",
    "bundle_status",
    "object_under_evaluation",
    "comparison_mode",
    "baseline_target",
    "method_set",
    "identity_contract",
    "selection_apply_contract",
    "admission",
    "comparison_units",
    "unmatched_cases",
    "verdict",
    "policy_verdict",
    "claim_boundary",
    "limitations"
  ],
  "properties": {
    "eval_name": {"const": "aoa-identity-bound-method-comparison"},
    "bundle_status": {"const": "draft"},
    "object_under_evaluation": {
      "const": "identity-bound comparison of validation methods under an explicit workload, candidate, environment, treatment, evidence, acceptance, cache, and resource contract"
    },
    "comparison_mode": {"const": "fixed-baseline"},
    "baseline_target": {"const": "legacy_serial_full_release"},
    "method_set": {
      "type": "array",
      "const": [
        "legacy_serial_full_release",
        "owner_focused_affected_only",
        "claim_evidence_activated_subgraph_or_tiered",
        "bounded_stable_prefix_session_measurement",
        "retry_after_fix_first_failure",
        "controlled_same_candidate_seeded_fault"
      ]
    },
    "identity_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_fields",
        "exact_match_required",
        "known_cache_and_resource_required_for_observed_pair",
        "allowed_evidence_classes"
      ],
      "properties": {
        "required_fields": {
          "type": "array",
          "const": [
            "workload_id",
            "candidate_or_source_identity",
            "source_ref_or_digest",
            "environment_id",
            "route_or_treatment_identity",
            "evidence_class",
            "acceptance_target",
            "cache_posture",
            "resource_posture"
          ]
        },
        "exact_match_required": {"const": true},
        "known_cache_and_resource_required_for_observed_pair": {"const": true},
        "allowed_evidence_classes": {"const": ["public-safe-contract", "reviewed-owner-packet"]}
      }
    },
    "selection_apply_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields", "received_verdict", "ready_for_owner_apply", "proof_authority"],
      "properties": {
        "required_fields": {
          "type": "array",
          "const": [
            "verdict",
            "owner",
            "source_ref",
            "source_digest",
            "environment",
            "command.argv",
            "command.cwd",
            "command.timeout_seconds",
            "command.accepted_exit_codes",
            "prerequisites",
            "artifacts",
            "pass_criteria",
            "effect_authority",
            "expected_effect",
            "proof_authority",
            "proof_limit"
          ]
        },
        "received_verdict": {"const": "exact_fit"},
        "ready_for_owner_apply": {"const": true},
        "proof_authority": {"const": false}
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_count",
        "unit_count",
        "matched_unit_count",
        "controlled_accounting_unit_count",
        "unmatched_unit_count",
        "matched_pair_count",
        "eligible_real_pairs",
        "unknown_is_not_zero",
        "method_effect_admitted"
      ],
      "properties": {
        "observation_count": {"type": "integer", "minimum": 1},
        "unit_count": {"type": "integer", "minimum": 1},
        "matched_unit_count": {"type": "integer", "minimum": 0},
        "controlled_accounting_unit_count": {"type": "integer", "minimum": 0},
        "unmatched_unit_count": {"type": "integer", "minimum": 0},
        "matched_pair_count": {"type": "integer", "minimum": 0},
        "eligible_real_pairs": {"type": "integer", "minimum": 0},
        "unknown_is_not_zero": {"const": true},
        "method_effect_admitted": {"const": false}
      }
    },
    "comparison_units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/comparison_unit"}
    },
    "unmatched_cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/unmatched_case"}
    },
    "verdict": {"enum": ["not_admitted", "matched_observation_only"]},
    "policy_verdict": {"type": "null"},
    "claim_boundary": {"type": "string", "minLength": 40},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {"const": "matched_observation_only"}
        }
      },
      "then": {
        "properties": {
          "admission": {
            "properties": {
              "matched_unit_count": {"minimum": 1},
              "matched_pair_count": {"minimum": 1},
              "eligible_real_pairs": {"minimum": 1}
            }
          },
          "comparison_units": {
            "contains": {
              "type": "object",
              "required": ["disposition", "matched_pair_count", "observed_pair_count", "matched_identity_bindings"],
              "properties": {
                "disposition": {"const": "matched_observation_only"},
                "matched_pair_count": {"minimum": 1},
                "observed_pair_count": {"minimum": 1},
                "matched_identity_bindings": {"minItems": 1}
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "metric_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_counts", "observed_values", "controlled_values", "synthetic_count"],
      "properties": {
        "state_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["known", "unknown", "null", "excluded", "unobservable", "missing"],
          "properties": {
            "known": {"type": "integer", "minimum": 0},
            "unknown": {"type": "integer", "minimum": 0},
            "null": {"type": "integer", "minimum": 0},
            "excluded": {"type": "integer", "minimum": 0},
            "unobservable": {"type": "integer", "minimum": 0},
            "missing": {"type": "integer", "minimum": 0}
          }
        },
        "observed_values": {
          "type": "array",
          "items": {"$ref": "#/$defs/metric_value"}
        },
        "controlled_values": {
          "type": "array",
          "items": {"$ref": "#/$defs/metric_value"}
        },
        "synthetic_count": {"type": "integer", "minimum": 0}
      }
    },
    "metric_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_id", "value", "unit"],
      "properties": {
        "method_id": {"type": "string", "minLength": 1},
        "value": {"type": "number", "minimum": 0},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "comparison_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "disposition",
        "matched_pair_count",
        "observed_pair_count",
        "method_ids",
        "review_statuses",
        "evidence_classes",
        "identity_match",
        "mismatched_fields",
        "observation_refs",
        "matched_identity_bindings",
        "metric_coverage",
        "claim_limit"
      ],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["matched_observation_only", "controlled_accounting_only", "unmatched"]},
        "matched_pair_count": {"type": "integer", "minimum": 0},
        "observed_pair_count": {"type": "integer", "minimum": 0},
        "method_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "review_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "identity_match": {"type": "boolean"},
        "mismatched_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "observation_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "matched_identity_bindings": {
          "type": "array",
          "items": {"$ref": "#/$defs/matched_identity_binding"}
        },
        "metric_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wall_seconds", "cpu_ms", "peak_rss_kib", "io_read_bytes", "io_write_bytes", "setup_startup_seconds", "first_failure_latency_seconds", "retry_amplification"],
          "properties": {
            "wall_seconds": {"$ref": "#/$defs/metric_coverage"},
            "cpu_ms": {"$ref": "#/$defs/metric_coverage"},
            "peak_rss_kib": {"$ref": "#/$defs/metric_coverage"},
            "io_read_bytes": {"$ref": "#/$defs/metric_coverage"},
            "io_write_bytes": {"$ref": "#/$defs/metric_coverage"},
            "setup_startup_seconds": {"$ref": "#/$defs/metric_coverage"},
            "first_failure_latency_seconds": {"$ref": "#/$defs/metric_coverage"},
            "retry_amplification": {"$ref": "#/$defs/metric_coverage"}
          }
        },
        "claim_limit": {"type": "string", "minLength": 10}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {"const": "matched_observation_only"}
            }
          },
          "then": {
            "properties": {
              "matched_pair_count": {"minimum": 1},
              "observed_pair_count": {"minimum": 1},
              "matched_identity_bindings": {"minItems": 1},
              "identity_match": {"const": true},
              "metric_coverage": {
                "anyOf": [
                  {"properties": {"wall_seconds": {"properties": {"observed_values": {"minItems": 2}}}}},
                  {"properties": {"cpu_ms": {"properties": {"observed_values": {"minItems": 2}}}}},
                  {"properties": {"peak_rss_kib": {"properties": {"observed_values": {"minItems": 2}}}}},
                  {"properties": {"io_read_bytes": {"properties": {"observed_values": {"minItems": 2}}}}},
                  {"properties": {"io_write_bytes": {"properties": {"observed_values": {"minItems": 2}}}}},
                  {"properties": {"setup_startup_seconds": {"properties": {"observed_values": {"minItems": 2}}}}},
                  {"properties": {"first_failure_latency_seconds": {"properties": {"observed_values": {"minItems": 2}}}}},
                  {"properties": {"retry_amplification": {"properties": {"observed_values": {"minItems": 2}}}}}
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {"const": "controlled_accounting_only"}
            }
          },
          "then": {
            "properties": {
              "matched_pair_count": {"minimum": 1},
              "matched_identity_bindings": {"minItems": 1},
              "identity_match": {"const": true}
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {"const": "unmatched"}
            }
          },
          "then": {
            "properties": {
              "identity_match": {"const": false}
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "matched_pair_count": {"const": 0},
                "matched_identity_bindings": {"maxItems": 0}
              }
            },
            {
              "properties": {
                "matched_pair_count": {"const": 1},
                "matched_identity_bindings": {"minItems": 1, "maxItems": 1}
              }
            },
            {
              "properties": {
                "matched_pair_count": {"const": 2},
                "matched_identity_bindings": {"minItems": 2, "maxItems": 2}
              }
            },
            {
              "properties": {
                "matched_pair_count": {"const": 3},
                "matched_identity_bindings": {"minItems": 3, "maxItems": 3}
              }
            },
            {
              "properties": {
                "matched_pair_count": {"const": 4},
                "matched_identity_bindings": {"minItems": 4, "maxItems": 4}
              }
            },
            {
              "properties": {
                "matched_pair_count": {"const": 5},
                "matched_identity_bindings": {"minItems": 5, "maxItems": 5}
              }
            }
          ]
        }
      ]
    },
    "matched_identity_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_ids", "identity", "evidence_provenance"],
      "properties": {
        "method_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": [
            "legacy_serial_full_release",
            "owner_focused_affected_only",
            "claim_evidence_activated_subgraph_or_tiered",
            "bounded_stable_prefix_session_measurement",
            "retry_after_fix_first_failure",
            "controlled_same_candidate_seeded_fault"
          ]}
        },
        "identity": {"$ref": "#/$defs/identity_snapshot"},
        "evidence_provenance": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_provenance"}
        }
      }
    },
    "identity_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload_id", "candidate_or_source_identity", "source_ref_or_digest", "environment_id", "route_or_treatment_identity", "evidence_class", "acceptance_target", "cache_posture", "resource_posture"],
      "properties": {
        "workload_id": {"type": "string", "minLength": 1},
        "candidate_or_source_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_ref_or_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "environment_id": {"type": "string", "minLength": 1},
        "route_or_treatment_identity": {"type": "string", "minLength": 1},
        "evidence_class": {"type": "string", "minLength": 1},
        "acceptance_target": {"type": "string", "minLength": 1},
        "cache_posture": {"$ref": "#/$defs/posture"},
        "resource_posture": {"$ref": "#/$defs/posture"}
      }
    },
    "posture": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "id"],
          "properties": {"status": {"const": "known"}, "id": {"type": "string", "minLength": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "id"],
          "properties": {"status": {"enum": ["unknown", "null", "excluded", "unobservable", "missing"]}, "id": {"type": "null"}}
        }
      ]
    },
    "evidence_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_id", "ref", "digest", "kind", "evidence_class"],
      "properties": {
        "method_id": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "kind": {"const": "public-safe-observation"},
        "evidence_class": {"enum": ["public-safe-contract", "reviewed-owner-packet"]}
      }
    },
    "unmatched_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "reason", "mismatched_fields"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "method_id": {"type": "string", "minLength": 1},
        "mismatched_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
