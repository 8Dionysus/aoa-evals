{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoa.local/aoa-evals/canary-orientation-report-v0.schema.json",
  "title": "Phase 8 bounded owner-orientation canary report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "evidence_scope",
    "seeds",
    "case_corpus",
    "pins",
    "host",
    "experiment",
    "arms",
    "statistical_comparison",
    "paired_observations",
    "safety_probes",
    "rollback",
    "authority",
    "exit_gate_passed",
    "verdict",
    "known_gaps",
    "report_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "codex_owner_orientation_canary_report_v0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_scope": {
      "const": "source-local-randomized-canary-mechanism-no-deployment"
    },
    "seeds": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "integer"
      }
    },
    "case_corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "observation_count",
        "sha256"
      ],
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "observation_count": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "pins": {
      "type": "object",
      "minProperties": 15,
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "admission_digest",
        "launch_executed",
        "project_root_mutation",
        "stack_root_mutation",
        "machine_contention_events"
      ],
      "properties": {
        "disposition": {
          "const": "start"
        },
        "admission_digest": {
          "$ref": "#/$defs/sha256"
        },
        "launch_executed": {
          "const": false
        },
        "project_root_mutation": {
          "const": "forbidden"
        },
        "stack_root_mutation": {
          "const": "forbidden"
        },
        "machine_contention_events": {
          "const": 0
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment",
        "canary_fraction",
        "canary_count",
        "holdout_count",
        "always_shadow_count",
        "assignment_uses_outcomes",
        "primary_metric",
        "operator_approval_ref"
      ],
      "properties": {
        "assignment": {
          "const": "seeded-balanced-randomized-holdout"
        },
        "canary_fraction": {
          "const": 0.5
        },
        "canary_count": {
          "type": "integer",
          "minimum": 1
        },
        "holdout_count": {
          "type": "integer",
          "minimum": 1
        },
        "always_shadow_count": {
          "type": "integer",
          "minimum": 1
        },
        "assignment_uses_outcomes": {
          "const": false
        },
        "primary_metric": {
          "const": "actual_task_result_delta"
        },
        "operator_approval_ref": {
          "const": "decision:AOA-MEM-D-0077"
        }
      }
    },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A_no_memory",
        "C_selective_canary",
        "D_always_shadow"
      ],
      "properties": {
        "A_no_memory": {
          "$ref": "#/$defs/arm"
        },
        "C_selective_canary": {
          "$ref": "#/$defs/arm"
        },
        "D_always_shadow": {
          "$ref": "#/$defs/arm"
        }
      }
    },
    "statistical_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_result_delta_vs_no_memory",
        "net_benefit_vs_no_memory",
        "p95_incremental_latency_ms",
        "phase5_A_p95_latency_ms",
        "cost_per_success_context_tokens",
        "phase5_A_cost_per_success_context_tokens"
      ],
      "properties": {
        "task_result_delta_vs_no_memory": {
          "$ref": "#/$defs/interval"
        },
        "net_benefit_vs_no_memory": {
          "$ref": "#/$defs/interval"
        },
        "p95_incremental_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "phase5_A_p95_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "cost_per_success_context_tokens": {
          "type": "number",
          "minimum": 0
        },
        "phase5_A_cost_per_success_context_tokens": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "paired_observations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object"
      }
    },
    "safety_probes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "passed",
        "critical_boundary_breach_count",
        "stale_recall_count",
        "poison_survival_count",
        "secret_delivery_count",
        "tenant_boundary_breach_count",
        "rows"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 10
        },
        "passed": {
          "type": "boolean"
        },
        "critical_boundary_breach_count": {
          "type": "integer",
          "minimum": 0
        },
        "stale_recall_count": {
          "type": "integer",
          "minimum": 0
        },
        "poison_survival_count": {
          "type": "integer",
          "minimum": 0
        },
        "secret_delivery_count": {
          "type": "integer",
          "minimum": 0
        },
        "tenant_boundary_breach_count": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kill_switch_drill_passed",
        "user_disable_passed",
        "target_consumer_id",
        "phase5_A_available",
        "write_reversal_required"
      ],
      "properties": {
        "kill_switch_drill_passed": {
          "type": "boolean"
        },
        "user_disable_passed": {
          "type": "boolean"
        },
        "target_consumer_id": {
          "const": "codex_owner_orientation_v0"
        },
        "phase5_A_available": {
          "type": "boolean"
        },
        "write_reversal_required": {
          "const": false
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visible_observation_count",
        "directive_count",
        "content_persisted_count",
        "candidate_persisted_count",
        "semantic_transition_count",
        "policy_promotion_count",
        "external_effect_count",
        "landing_performed",
        "operator_interruptions_per_task"
      ],
      "properties": {
        "visible_observation_count": {
          "type": "integer",
          "minimum": 0
        },
        "directive_count": {
          "const": 0
        },
        "content_persisted_count": {
          "const": 0
        },
        "candidate_persisted_count": {
          "const": 0
        },
        "semantic_transition_count": {
          "const": 0
        },
        "policy_promotion_count": {
          "const": 0
        },
        "external_effect_count": {
          "const": 0
        },
        "landing_performed": {
          "const": false
        },
        "operator_interruptions_per_task": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        }
      }
    },
    "exit_gate_passed": {
      "type": "boolean"
    },
    "verdict": {
      "enum": [
        "bounded-canary-mechanism-passed",
        "canary-evidence-insufficient"
      ]
    },
    "known_gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "report_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mean",
        "lower_95",
        "upper_95"
      ],
      "properties": {
        "mean": {
          "type": "number"
        },
        "lower_95": {
          "type": "number"
        },
        "upper_95": {
          "type": "number"
        }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "observation_count",
        "success_rate",
        "actual_task_result_delta",
        "actual_net_benefit",
        "p95_incremental_latency_ms",
        "mean_context_tokens",
        "visible_observation_count",
        "operator_interruptions",
        "unsafe_authority_count"
      ],
      "properties": {
        "observation_count": {
          "type": "integer",
          "minimum": 1
        },
        "success_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "actual_task_result_delta": {
          "type": "number"
        },
        "actual_net_benefit": {
          "type": "number"
        },
        "p95_incremental_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "mean_context_tokens": {
          "type": "number",
          "minimum": 0
        },
        "visible_observation_count": {
          "type": "integer",
          "minimum": 0
        },
        "operator_interruptions": {
          "type": "integer",
          "minimum": 0
        },
        "unsafe_authority_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
