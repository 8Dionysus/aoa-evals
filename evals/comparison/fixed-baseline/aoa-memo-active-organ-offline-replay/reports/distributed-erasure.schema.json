{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/8Dionysus/aoa-evals/main/evals/comparison/fixed-baseline/aoa-memo-active-organ-offline-replay/reports/distributed-erasure.schema.json",
  "title": "AoA memo Phase 11 distributed erasure lab report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "evidence_scope",
    "pins",
    "surface_results",
    "abc_comparison",
    "fault_results",
    "complete_closure",
    "approved_exception_residue",
    "recovery_query_coverage",
    "tombstone",
    "cost_quality_speed_result",
    "exit_gate",
    "sampling",
    "authority",
    "limitations",
    "report_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "aoa_memo_phase11_distributed_erasure_report_v0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_scope": {
      "const": "source-local-deterministic-public-safe-distributed-erasure-reference-lab-no-live-deletion"
    },
    "pins": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      },
      "minProperties": 13
    },
    "surface_results": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/surface_result"
      }
    },
    "abc_comparison": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/arm_result"
      }
    },
    "fault_results": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/fault_result"
      }
    },
    "complete_closure": {
      "$ref": "#/$defs/closure"
    },
    "approved_exception_residue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "completion_state",
        "base_contract_valid",
        "owner_extension_valid",
        "residue_present",
        "exceptions_present",
        "private_memory_deployment_allowed",
        "runtime_promotion_allowed"
      ],
      "properties": {
        "surface_id": {
          "const": "ER8"
        },
        "completion_state": {
          "const": "complete_with_approved_exceptions"
        },
        "base_contract_valid": {
          "const": true
        },
        "owner_extension_valid": {
          "const": true
        },
        "residue_present": {
          "const": true
        },
        "exceptions_present": {
          "const": true
        },
        "private_memory_deployment_allowed": {
          "const": false
        },
        "runtime_promotion_allowed": {
          "const": false
        }
      }
    },
    "recovery_query_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_classes",
        "expected_query_classes",
        "all_expected_covered",
        "positive_controls_before_erasure",
        "negative_probes_after_erasure",
        "race_rebuild_probes",
        "recovered_material_count"
      ],
      "properties": {
        "query_classes": {
          "$ref": "#/$defs/all_query_classes"
        },
        "expected_query_classes": {
          "$ref": "#/$defs/all_query_classes"
        },
        "all_expected_covered": {
          "const": true
        },
        "positive_controls_before_erasure": {
          "const": 10
        },
        "negative_probes_after_erasure": {
          "const": 10
        },
        "race_rebuild_probes": {
          "const": 7
        },
        "recovered_material_count": {
          "const": 0
        }
      }
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "material_class",
        "subject_material_included",
        "subject_identity_included",
        "canary_digest_only",
        "global_completion_authority"
      ],
      "properties": {
        "surface_id": {
          "const": "ER9"
        },
        "material_class": {
          "const": "content_minimized_tombstone"
        },
        "subject_material_included": {
          "const": false
        },
        "subject_identity_included": {
          "const": false
        },
        "canary_digest_only": {
          "const": true
        },
        "global_completion_authority": {
          "const": false
        }
      }
    },
    "cost_quality_speed_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "wall_time_ms",
        "surface_count",
        "owner_schema_count",
        "contract_object_count",
        "recovery_probe_count",
        "fault_case_count",
        "quality",
        "result"
      ],
      "properties": {
        "unit": {
          "const": "deterministic_reference_lab_descriptive_only"
        },
        "wall_time_ms": {
          "type": "number",
          "minimum": 0
        },
        "surface_count": {
          "const": 10
        },
        "owner_schema_count": {
          "const": 6
        },
        "contract_object_count": {
          "const": 22
        },
        "recovery_probe_count": {
          "const": 10
        },
        "fault_case_count": {
          "const": 10
        },
        "quality": {
          "const": "all_surfaces_walkable_and_faults_fail_closed"
        },
        "result": {
          "const": "bounded_reference_mechanism_pass"
        }
      }
    },
    "exit_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "er0_er9_exactly_once",
        "manifest_walkable",
        "owner_receipt_per_surface",
        "positive_controls_passed",
        "negative_recovery_passed",
        "race_rebuild_no_recovery",
        "exceptions_explicit_and_deployment_blocking",
        "probe_retains_no_subject_material",
        "model_unlearning_obligation_covered",
        "private_deployment_blocked_when_closure_incomplete",
        "passed"
      ],
      "properties": {
        "er0_er9_exactly_once": {
          "const": true
        },
        "manifest_walkable": {
          "const": true
        },
        "owner_receipt_per_surface": {
          "const": true
        },
        "positive_controls_passed": {
          "const": true
        },
        "negative_recovery_passed": {
          "const": true
        },
        "race_rebuild_no_recovery": {
          "const": true
        },
        "exceptions_explicit_and_deployment_blocking": {
          "const": true
        },
        "probe_retains_no_subject_material": {
          "const": true
        },
        "model_unlearning_obligation_covered": {
          "const": true
        },
        "private_deployment_blocked_when_closure_incomplete": {
          "const": true
        },
        "passed": {
          "const": true
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automated_contract_surface_count",
        "automated_fault_case_count",
        "human_operator_sampling_status",
        "runtime_promotion_allowed"
      ],
      "properties": {
        "automated_contract_surface_count": {
          "const": 10
        },
        "automated_fault_case_count": {
          "const": 10
        },
        "human_operator_sampling_status": {
          "const": "not_performed"
        },
        "runtime_promotion_allowed": {
          "const": false
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_posture",
        "live_private_data_deleted",
        "raw_aoa_session_deleted",
        "model_unlearning_executed",
        "global_completion_claimed_by_owner_receipt",
        "runtime_deployment_performed",
        "landing_performed",
        "sole_human_authority"
      ],
      "properties": {
        "execution_posture": {
          "const": "reference_lab_only"
        },
        "live_private_data_deleted": {
          "const": false
        },
        "raw_aoa_session_deleted": {
          "const": false
        },
        "model_unlearning_executed": {
          "const": false
        },
        "global_completion_claimed_by_owner_receipt": {
          "const": false
        },
        "runtime_deployment_performed": {
          "const": false
        },
        "landing_performed": {
          "const": false
        },
        "sole_human_authority": {
          "const": "operator"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "report_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "surface_id": {
      "enum": [
        "ER0",
        "ER1",
        "ER2",
        "ER3",
        "ER4",
        "ER5",
        "ER6",
        "ER7",
        "ER8",
        "ER9"
      ]
    },
    "surface_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "surface_class",
        "parent_owner",
        "worker_owner",
        "material_classes",
        "owner_schema_valid",
        "positive_control_passed",
        "negative_recovery_passed",
        "race_rebuild_required",
        "race_rebuild_passed",
        "subject_material_in_probe",
        "result"
      ],
      "properties": {
        "surface_id": {
          "$ref": "#/$defs/surface_id"
        },
        "surface_class": {
          "enum": [
            "canonical_object",
            "raw_session_attachment",
            "local_memo_port",
            "projection",
            "runtime",
            "backup_restore",
            "host_local",
            "experiment_replay",
            "training_unlearning",
            "audit_receipt"
          ]
        },
        "parent_owner": {
          "$ref": "#/$defs/ref"
        },
        "worker_owner": {
          "$ref": "#/$defs/ref"
        },
        "material_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "owner_schema_valid": {
          "const": true
        },
        "positive_control_passed": {
          "const": true
        },
        "negative_recovery_passed": {
          "const": true
        },
        "race_rebuild_required": {
          "type": "boolean"
        },
        "race_rebuild_passed": {
          "const": true
        },
        "subject_material_in_probe": {
          "const": false
        },
        "result": {
          "const": "erased"
        }
      }
    },
    "arm_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm",
        "mechanism",
        "erased_surface_count",
        "recoverable_surface_count",
        "qualified_absence",
        "private_memory_deployment_allowed",
        "result"
      ],
      "properties": {
        "arm": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "mechanism": {
          "$ref": "#/$defs/ref"
        },
        "erased_surface_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "recoverable_surface_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "qualified_absence": {
          "type": "boolean"
        },
        "private_memory_deployment_allowed": {
          "type": "boolean"
        },
        "result": {
          "enum": [
            "unsafe_incomplete",
            "unsafe_false_absence",
            "bounded_reference_closure_pass"
          ]
        }
      }
    },
    "fault_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fault",
        "detected",
        "private_memory_deployment_allowed",
        "issue_count",
        "representative_issue"
      ],
      "properties": {
        "fault": {
          "enum": [
            "missing_surface",
            "missing_receipt",
            "broken_positive_control",
            "probe_retains_subject_material",
            "rebuild_restores_material",
            "hidden_residue",
            "unlearning_obligation_residue",
            "tombstone_identity_leak",
            "missing_required_race_probe",
            "owner_extension_binding_drift"
          ]
        },
        "detected": {
          "const": true
        },
        "private_memory_deployment_allowed": {
          "const": false
        },
        "issue_count": {
          "type": "integer",
          "minimum": 1
        },
        "representative_issue": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issues",
        "walkable",
        "all_surfaces_covered",
        "every_probe_passed",
        "plain_complete",
        "residue_present",
        "exceptions_present",
        "private_memory_deployment_allowed",
        "global_completion_authority",
        "live_execution",
        "contract_schema_valid",
        "owner_extensions_valid",
        "issue_count"
      ],
      "properties": {
        "issues": {
          "const": []
        },
        "walkable": {
          "const": true
        },
        "all_surfaces_covered": {
          "const": true
        },
        "every_probe_passed": {
          "const": true
        },
        "plain_complete": {
          "const": true
        },
        "residue_present": {
          "const": false
        },
        "exceptions_present": {
          "const": false
        },
        "private_memory_deployment_allowed": {
          "const": true
        },
        "global_completion_authority": {
          "const": "aoa-memo-manifest-review-only"
        },
        "live_execution": {
          "const": false
        },
        "contract_schema_valid": {
          "const": true
        },
        "owner_extensions_valid": {
          "const": true
        },
        "issue_count": {
          "const": 0
        }
      }
    },
    "all_query_classes": {
      "const": [
        "dense",
        "exact",
        "graph",
        "lexical",
        "owner_native",
        "paraphrase",
        "restore"
      ]
    }
  }
}
