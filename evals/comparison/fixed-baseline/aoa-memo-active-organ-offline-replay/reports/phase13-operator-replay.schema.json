{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-of-abyss.local/schemas/aoa-memo-phase13-operator-replay-v1.json",
  "title": "AoA memo Phase 13 retrospective operator-orientation replay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "generated_at",
    "posture",
    "inputs",
    "model",
    "host_admission",
    "execution",
    "by_arm",
    "paired_correction_proxy",
    "operator_pressure",
    "silence",
    "observations",
    "claim_limits",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_id": {
      "enum": [
        "aoa-memo-phase13-retrospective-operator-orientation-v1",
        "aoa-memo-phase13-retrospective-operator-orientation-v2",
        "aoa-memo-phase13-retrospective-operator-orientation-v3"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "posture": {
      "const": "retrospective_sanitized_counterfactual_upper_bound"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_path",
        "contract_sha256",
        "source_fixture_path",
        "source_fixture_sha256",
        "raw_bodies_embedded"
      ],
      "properties": {
        "contract_path": {
          "type": "string",
          "minLength": 1
        },
        "contract_sha256": {
          "$ref": "#/$defs/digest"
        },
        "source_fixture_path": {
          "type": "string",
          "minLength": 1
        },
        "source_fixture_sha256": {
          "$ref": "#/$defs/digest"
        },
        "raw_bodies_embedded": {
          "const": false
        },
        "runner_path": {
          "type": "string",
          "minLength": 1
        },
        "runner_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "model_id",
        "model_revision",
        "runtime_id",
        "endpoint",
        "temperature",
        "max_tokens",
        "seeds"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "runtime_id": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]+$"
        },
        "temperature": {
          "const": 0
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "seeds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "host_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_plan_path",
        "resource_plan_sha256",
        "host_status_path",
        "host_status_sha256",
        "decision",
        "forced",
        "resource_admission_bypassed"
      ],
      "properties": {
        "resource_plan_path": {
          "type": "string",
          "minLength": 1
        },
        "resource_plan_sha256": {
          "$ref": "#/$defs/digest"
        },
        "host_status_path": {
          "type": "string",
          "minLength": 1
        },
        "host_status_sha256": {
          "$ref": "#/$defs/digest"
        },
        "decision": {
          "const": "allow"
        },
        "forced": {
          "const": false
        },
        "resource_admission_bypassed": {
          "const": false
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted_count",
        "complete_count",
        "invalid_count",
        "resumed_observation_count",
        "hidden_retry",
        "checkpoint_path",
        "checkpoint_sha256"
      ],
      "properties": {
        "attempted_count": {
          "type": "integer",
          "minimum": 1
        },
        "complete_count": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_count": {
          "type": "integer",
          "minimum": 0
        },
        "resumed_observation_count": {
          "type": "integer",
          "minimum": 0
        },
        "hidden_retry": {
          "const": false
        },
        "checkpoint_path": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "by_arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "0",
        "A"
      ],
      "properties": {
        "0": {
          "$ref": "#/$defs/arm"
        },
        "A": {
          "$ref": "#/$defs/arm"
        }
      }
    },
    "paired_correction_proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A_better",
        "same",
        "A_worse"
      ],
      "properties": {
        "A_better": {
          "type": "integer",
          "minimum": 0
        },
        "same": {
          "type": "integer",
          "minimum": 0
        },
        "A_worse": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "operator_pressure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_legacy_case_count",
        "observed_legacy_operator_correction_count",
        "eligible_legacy_correction_case_count",
        "eligible_model_correction_proxy_by_arm",
        "proxy_delta_0_minus_A",
        "outcome_attribution_established",
        "operator_workload_reduction_established"
      ],
      "properties": {
        "reviewed_legacy_case_count": {
          "type": "integer",
          "minimum": 1
        },
        "observed_legacy_operator_correction_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_legacy_correction_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_model_correction_proxy_by_arm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "0",
            "A"
          ],
          "properties": {
            "0": {
              "type": "integer",
              "minimum": 0
            },
            "A": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "proxy_delta_0_minus_A": {
          "type": "integer"
        },
        "outcome_attribution_established": {
          "const": false
        },
        "operator_workload_reduction_established": {
          "const": false
        }
      }
    },
    "silence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_count",
        "correct_count",
        "specificity"
      ],
      "properties": {
        "required_count": {
          "type": "integer",
          "minimum": 1
        },
        "correct_count": {
          "type": "integer",
          "minimum": 0
        },
        "specificity": {
          "$ref": "#/$defs/rate"
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "prompt_id",
          "case_id",
          "seed",
          "arm_id",
          "prompt_sha256",
          "attempt_index",
          "retry_count",
          "expected_decision",
          "expected_influence",
          "orientation_eligible",
          "legacy_operator_correction_count",
          "status",
          "latency_ms",
          "response",
          "usage",
          "valid_response_shape",
          "decision_correct",
          "memory_influence_correct",
          "owner_route_hit",
          "correction_required_proxy",
          "authority_violation"
        ],
        "properties": {
          "prompt_id": {
            "type": "string",
            "minLength": 1
          },
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "seed": {
            "type": "integer"
          },
          "arm_id": {
            "enum": [
              "0",
              "A"
            ]
          },
          "prompt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "attempt_index": {
            "type": "integer",
            "minimum": 0
          },
          "retry_count": {
            "const": 0
          },
          "expected_decision": {
            "type": "string",
            "minLength": 1
          },
          "expected_influence": {
            "enum": [
              "none",
              "used",
              "silence"
            ]
          },
          "orientation_eligible": {
            "type": "boolean"
          },
          "legacy_operator_correction_count": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "complete",
              "invalid"
            ]
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ]
          },
          "latency_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "response": {
            "type": "string"
          },
          "usage": {
            "type": "object"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "parsed_response": {
            "type": [
              "object",
              "null"
            ]
          },
          "valid_response_shape": {
            "type": "boolean"
          },
          "decision_correct": {
            "type": "boolean"
          },
          "memory_influence_correct": {
            "type": "boolean"
          },
          "owner_route_hit": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "owner_route_contract_correct": {
            "type": "boolean"
          },
          "unsupported_owner_route": {
            "type": "boolean"
          },
          "correction_required_proxy": {
            "type": "boolean"
          },
          "authority_violation": {
            "type": "boolean"
          }
        }
      }
    },
    "claim_limits": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benefit_verdict",
        "operator_workload_reduction",
        "policy_promotion",
        "production",
        "training",
        "landing"
      ],
      "properties": {
        "benefit_verdict": {
          "const": false
        },
        "operator_workload_reduction": {
          "const": false
        },
        "policy_promotion": {
          "const": false
        },
        "production": {
          "const": false
        },
        "training": {
          "const": false
        },
        "landing": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "complete",
        "invalid_response_count",
        "decision_accuracy",
        "memory_influence_accuracy",
        "eligible_owner_route_hit_rate",
        "correction_required_proxy_count",
        "authority_violation_count",
        "mean_prompt_tokens",
        "mean_completion_tokens",
        "p50_latency_ms",
        "p95_latency_ms",
        "p99_latency_ms"
      ],
      "properties": {
        "attempted": {
          "type": "integer",
          "minimum": 1
        },
        "complete": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_response_count": {
          "type": "integer",
          "minimum": 0
        },
        "decision_accuracy": {
          "$ref": "#/$defs/rate"
        },
        "memory_influence_accuracy": {
          "$ref": "#/$defs/rate"
        },
        "eligible_owner_route_hit_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "owner_route_contract_accuracy": {
          "$ref": "#/$defs/rate"
        },
        "unsupported_owner_route_count": {
          "type": "integer",
          "minimum": 0
        },
        "correction_required_proxy_count": {
          "type": "integer",
          "minimum": 0
        },
        "authority_violation_count": {
          "type": "integer",
          "minimum": 0
        },
        "mean_prompt_tokens": {
          "type": "number",
          "minimum": 0
        },
        "mean_completion_tokens": {
          "type": "number",
          "minimum": 0
        },
        "p50_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "p95_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "p99_latency_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
