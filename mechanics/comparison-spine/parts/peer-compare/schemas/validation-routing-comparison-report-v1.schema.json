{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aoa-evals://comparison-spine/peer-compare/validation-routing-comparison-report-v1",
  "title": "Validation Routing Comparison Report v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "report_kind",
    "comparison_mode",
    "claim_posture",
    "policy_verdict",
    "selection_status",
    "fixture_id",
    "comparison_identity",
    "comparison_identity_digest",
    "input_evidence",
    "candidate_catalog",
    "adversarial_classes_covered",
    "coverage_limits",
    "methods",
    "scenario_count",
    "real_case_count",
    "seeded_case_count",
    "oracle_rule"
  ],
  "properties": {
    "schema_version": {"const": "validation_routing_comparison_report_v1"},
    "report_kind": {"const": "seeded_validation_routing_method_measurement"},
    "comparison_mode": {"const": "peer-compare"},
    "claim_posture": {"const": "measurement_only"},
    "policy_verdict": {"type": ["null", "string"]},
    "selection_status": {"type": "string"},
    "fixture_id": {"type": "string"},
    "comparison_identity": {"type": "object"},
    "comparison_identity_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_evidence": {"type": "object"},
    "candidate_catalog": {"type": "array", "minItems": 1},
    "adversarial_classes_covered": {"type": "array"},
    "coverage_limits": {"type": "array", "minItems": 1},
    "methods": {"type": "array", "minItems": 1},
    "scenario_count": {"type": "integer", "minimum": 1},
    "real_case_count": {"type": "integer", "minimum": 0},
    "seeded_case_count": {"type": "integer", "minimum": 1},
    "oracle_rule": {"type": "object"}
  }
}
